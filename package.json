{
  "name": "docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "og:generate": "npx tsx scripts/generate-og-image.mts",
    "prebuild": "npm run og:generate",
    "build": "astro build && node scripts/finalize-docs.mjs && npm run check:docs && npm run check:first-load",
    "preview": "astro preview",
    "astro": "astro",
    "check:first-load": "node scripts/check-first-load.mjs --budget=25",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.38.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "astro": "^6.0.1",
    "posthog-js": "^1.427.2",
    "sharp": "^0.34.2",
    "starlight-llms-txt": "^0.10.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.26.0",
    "tsx": "^4.21.0"
  }
}
