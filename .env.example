# PostHog project API key (the public, client-side "phc_..." key).
#
# Use the SAME key as the landing repository (archcore.ai). One PostHog project
# covers both sites: the `site` super property separates "docs" from "landing"
# and "content" in reports, while the cookie scoped to .archcore.ai keeps a
# visitor who reads the marketing site and then the docs as one person in one
# session. Two projects would break every cross-surface funnel.
#
# A production build fails without this rather than publishing pages whose
# analytics silently do nothing. Set ALLOW_MISSING_ANALYTICS_KEY=1 to build
# without analytics on purpose.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
